<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AiAutomations.Core\AiAutomations.Core.csproj" />
    <ProjectReference Include="..\AiAutomations.Infrastructure\AiAutomations.Infrastructure.csproj" />
    <ProjectReference Include="..\AiAutomations.Shared\AiAutomations.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows-flavored TFM so Windows.Storage.ApplicationData (packaged apps' documented
         per-app local storage location) is available without pulling in WinUI/Windows App SDK. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
