<Page
    x:Class="AiAutomations.Desktop.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image x:Name="AppIconImage" Width="48" Height="48" />
            <StackPanel>
                <TextBlock Text="AI Automations" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="Gray" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                   Text="A personal Slack triage assistant - watches for messages that need a reply, a task, or an implementation, classifies them with AI, and tracks the resulting work. Runs in the background from the system tray; the ASP.NET server and Blazor web client share the same core logic for remote/browser access." />

        <StackPanel Spacing="4">
            <TextBlock Text="CONTACT" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
            <TextBlock x:Name="ContactText" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="DATA" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="Gray" />
        </StackPanel>
    </StackPanel>
</Page>
