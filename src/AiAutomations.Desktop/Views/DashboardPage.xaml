<Page
    x:Class="AiAutomations.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" />

            <Border x:Name="PendingCta" Visibility="Collapsed" Padding="16" CornerRadius="8"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="PendingCtaTitle" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Review drafted replies, tickets, and task briefs before they go out."
                                   FontSize="12" Foreground="Gray" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open Inbox" Click="OnOpenInbox"
                            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- At-a-glance numbers. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="PendingCountText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Pending" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="ProcessingCountText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Processing now" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="NewHistoryCountText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="New (24h)" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="ActiveTasksCountText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Active tasks" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="AiCallsCountText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="AI calls (24h)" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent activity" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel x:Name="RecentActivityPanel" Spacing="0" />
                        <TextBlock x:Name="RecentActivityEmptyText" Text="Nothing triaged yet."
                                   Foreground="Gray" FontSize="12" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Health" FontWeight="SemiBold" FontSize="15" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="DbDot" Width="10" Height="10" Fill="Gray" />
                                <TextBlock Text="Database" Width="80" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="DbStatusText" Foreground="Gray" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="SlackDot" Width="10" Height="10" Fill="Gray" />
                                <TextBlock Text="Slack" Width="80" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="SlackStatusText" Foreground="Gray" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="AiDot" Width="10" Height="10" Fill="Gray" />
                                <TextBlock Text="AI provider" Width="80" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="AiStatusText" Foreground="Gray" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Tasks by status" FontWeight="SemiBold" FontSize="15" />
                            <StackPanel x:Name="TasksByStatusPanel" Spacing="8" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AI usage by model (24h)" FontWeight="SemiBold" FontSize="15" />
                            <StackPanel x:Name="AiUsageByModelPanel" Spacing="8" />
                            <TextBlock x:Name="AiUsageEmptyText" Text="No AI calls in the last 24 hours."
                                       Foreground="Gray" FontSize="12" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
