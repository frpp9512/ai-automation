<Page
    x:Class="AiAutomations.Desktop.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Inbox" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Secondary feature - collapsed by default so the pending items below get the space. -->
        <Expander Grid.Row="1" Header="Catch up on past messages" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Margin="0,0,0,16" IsExpanded="False">
            <StackPanel Spacing="8" Padding="4">
                <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                           Text="Find messages sent to you or mentioning you (or a group you belong to) in a date range, and run them through the same triage as a live message." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CalendarDatePicker x:Name="BackfillFromPicker" Header="From" Width="160" />
                    <CalendarDatePicker x:Name="BackfillToPicker" Header="To" Width="160" />
                    <Button x:Name="BackfillButton" Content="Backfill" Click="OnBackfill"
                            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                </StackPanel>

                <StackPanel x:Name="BackfillRunningPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Name="BackfillRunningText" FontSize="12" Foreground="Gray" />
                </StackPanel>
                <InfoBar x:Name="BackfillResultBar" IsOpen="False" IsClosable="False" />
            </StackPanel>
        </Expander>

        <ProgressRing Grid.Row="2" x:Name="LoadingRing" IsActive="False" Width="20" Height="20"
                      HorizontalAlignment="Left" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="3">
            <StackPanel x:Name="CardsPanel" Spacing="0">
                <TextBlock x:Name="EmptyText" Text="Nothing pending approval." Foreground="Gray" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
