<Page
    x:Class="AiAutomations.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

            <Border Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="Connections" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                               Text="Slack and AI provider credentials - edited here instead of hand-editing settings.json. Changes apply after restarting the app." />

                    <TextBlock Text="SLACK" FontWeight="SemiBold" FontSize="11" Foreground="Gray" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PasswordBox x:Name="SlackBotTokenBox" Header="Bot token (xoxb-...)" Width="280" />
                        <PasswordBox x:Name="SlackAppLevelTokenBox" Header="App-level token (xapp-...)" Width="280" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PasswordBox x:Name="SlackUserTokenBox" Header="User token (xoxp-..., optional - for backfill)" Width="280" />
                        <TextBox x:Name="SlackSelfUserIdBox" Header="Self user ID" Width="280" />
                    </StackPanel>

                    <TextBlock Text="AI PROVIDER" FontWeight="SemiBold" FontSize="11" Foreground="Gray" Margin="0,8,0,0" />
                    <ComboBox x:Name="AiProviderBox" Header="Provider" Width="200">
                        <ComboBoxItem Content="OpenAI-compatible (free/router)" Tag="OpenAiCompatible" />
                        <ComboBoxItem Content="Anthropic" Tag="Anthropic" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PasswordBox x:Name="AnthropicApiKeyBox" Header="Anthropic API key" Width="280" />
                        <TextBox x:Name="AnthropicModelBox" Header="Anthropic model" Width="280" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PasswordBox x:Name="OpenAiApiKeyBox" Header="OpenAI-compatible API key" Width="280" />
                        <TextBox x:Name="OpenAiBaseUrlBox" Header="Base URL" Width="280" />
                    </StackPanel>
                    <TextBox x:Name="OpenAiModelBox" Header="OpenAI-compatible model" Width="280" HorizontalAlignment="Left" />

                    <InfoBar x:Name="ConnectionsSavedBar" Severity="Success" IsOpen="False" IsClosable="True"
                             Title="Saved" Message="Restart the app for these changes to take effect." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SaveConnectionsButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveConnections" />
                        <Button x:Name="RestartButton" Content="Restart app now" Click="OnRestartApp" Visibility="Collapsed" />
                        <Button x:Name="ExportSettingsButton" Content="Export settings..." Click="OnExportSettings" />
                        <Button x:Name="ImportSettingsButton" Content="Import settings..." Click="OnImportSettings" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Theme" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemePicker" Width="140" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Auto" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <Border Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="Backup &amp; restore" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                               Text="The database lives inside the app's packaged storage, which an uninstall wipes completely - back it up somewhere outside that folder (Documents, OneDrive, etc.) so an accidental uninstall or reinstall doesn't lose your history." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BackupButton" Content="Back up database..." Click="OnBackupDatabase" />
                        <Button x:Name="RestoreButton" Content="Restore from backup..." Click="OnRestoreDatabase" />
                    </StackPanel>
                    <InfoBar x:Name="BackupRestoreBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="Repositories" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" TextWrapping="Wrap"
                       Text="Known repositories the classifier can suggest for implementation/planning tasks." />

            <StackPanel x:Name="RepoPanel" Spacing="0" />

            <Border Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox x:Name="NewNameBox" Header="Name" Width="200" />
                        <TextBox x:Name="NewPathBox" Header="Path" Width="280" />
                        <TextBox x:Name="NewKeywordsBox" Header="Keywords" Width="300" PlaceholderText="comma-separated, what it's about" />
                    </StackPanel>
                    <Button x:Name="AddButton" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="OnAdd" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
