<ContentDialog
    x:Class="AiAutomations.Desktop.Views.Controls.DeclineFeedbackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Decline with feedback"
    PrimaryButtonText="Send &amp; decline"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="380" MaxWidth="440">
        <TextBlock Text="This declines the item and posts the message below to the originating Slack thread - review (and edit if you like) first."
                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        <TextBox x:Name="MessageBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
    </StackPanel>
</ContentDialog>
