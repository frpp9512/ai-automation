<ContentDialog
    x:Class="AiAutomations.Desktop.Views.Controls.HealthDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Health"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="360" MaxWidth="420">
        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="18" Height="18" HorizontalAlignment="Left" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="DbDot" Width="10" Height="10" Fill="Gray" />
            <TextBlock Text="Database" Width="90" VerticalAlignment="Center" />
            <TextBlock x:Name="DbStatusText" Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="SlackDot" Width="10" Height="10" Fill="Gray" />
            <TextBlock Text="Slack" Width="90" VerticalAlignment="Center" />
            <TextBlock x:Name="SlackStatusText" Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="AiDot" Width="10" Height="10" Fill="Gray" />
            <TextBlock Text="AI provider" Width="90" VerticalAlignment="Center" />
            <TextBlock x:Name="AiStatusText" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Processing now" Width="108" VerticalAlignment="Center" />
            <TextBlock x:Name="PendingCountText" Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="ConfigWarning" Severity="Warning" IsOpen="False" IsClosable="False"
                 Title="Not fully configured yet" />

        <StackPanel Spacing="8">
            <TextBlock Text="AI USAGE (LAST 24H)" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />

            <Grid x:Name="AiUsageTilesGrid" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="CallsCountText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Calls" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TokensText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Tokens (in / out)" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="CostText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Est. cost" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="AiUsageEmptyText" Text="No AI calls in the last 24 hours."
                       Foreground="Gray" FontSize="12" Visibility="Collapsed" />
            <TextBlock x:Name="AiUsageUnavailableText" Text="Usage data unavailable."
                       Foreground="Gray" FontSize="12" Visibility="Collapsed" />

            <StackPanel x:Name="AiUsageByModelPanel" Spacing="10" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
