<ContentDialog
    x:Class="AiAutomations.Desktop.Views.Controls.ActionReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Check before approving"
    PrimaryButtonText="Approve"
    SecondaryButtonText="Discard"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="12" MinWidth="420" MaxWidth="480">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" />
            <ComboBox x:Name="RepoPicker" Header="Repository" Visibility="Collapsed" HorizontalAlignment="Stretch" />
            <TextBox x:Name="PayloadBox" Header="Details" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="140" FontFamily="Consolas" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
