<UserControl
    x:Class="AiAutomations.Desktop.Views.Controls.WorkItemCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,8">
        <Border x:Name="AccentBar" Width="4" Background="Gray" CornerRadius="6,0,0,6" HorizontalAlignment="Left" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="4,0,0,0">
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TypeBadge" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="1" Content="Edit" Padding="4,0" FontSize="11" Click="OnEdit" />
                    <Button Grid.Column="2" x:Name="DeleteButton" Content="&#x2715;" Background="Transparent"
                            BorderThickness="0" Padding="4,0" FontSize="12" Foreground="Gray" Click="OnDelete" />
                </Grid>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" />
                <TextBlock x:Name="DescriptionText" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                <StackPanel x:Name="ProgressRow" Spacing="2">
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="ProgressLabel" FontSize="10" Foreground="Gray" />
                </StackPanel>

                <StackPanel x:Name="MetaRow" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="RepoText" Foreground="Gray" FontSize="11" FontFamily="Consolas" />
                    <TextBlock x:Name="DueText" Foreground="Gray" FontSize="11" />
                    <TextBlock x:Name="CommentCountText" Foreground="Gray" FontSize="11" />
                    <HyperlinkButton x:Name="OpenProjectLink" Content="OpenProject &#x2197;" Padding="0" FontSize="11"
                                     Visibility="Collapsed" Click="OnOpenExternalLink" />
                </StackPanel>
                <StackPanel x:Name="RepoConfirmPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Needs a repository:" FontSize="11" Foreground="Orange" VerticalAlignment="Center" />
                    <ComboBox x:Name="RepoConfirmPicker" Width="160" FontSize="11" PlaceholderText="Pick one..."
                              SelectionChanged="OnRepoConfirmed" />
                </StackPanel>
                <ComboBox x:Name="StatusPicker" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                          SelectionChanged="OnStatusChanged" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
