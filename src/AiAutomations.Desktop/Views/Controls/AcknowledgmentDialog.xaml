<ContentDialog
    x:Class="AiAutomations.Desktop.Views.Controls.AcknowledgmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Send an acknowledgment to Slack?"
    PrimaryButtonText="Send to Slack"
    CloseButtonText="Don't send"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="380" MaxWidth="440">
        <TextBlock Text="This is always optional - review (and edit if you like) before sending."
                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        <TextBox x:Name="MessageBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
    </StackPanel>
</ContentDialog>
