<ContentDialog
    x:Class="AiAutomations.Desktop.Views.Controls.ActionDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Item details"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="520">
        <StackPanel Spacing="12" MinWidth="420" MaxWidth="480">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="TypeText" FontWeight="SemiBold" />
                <TextBlock x:Name="UrgencyText" Foreground="Gray" />
                <TextBlock x:Name="ConfidenceText" Foreground="Gray" />
                <TextBlock x:Name="StatusText" Foreground="Gray" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="SUMMARY" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="FailureBar" Severity="Error" IsOpen="False" IsClosable="False" Title="This action failed" />

            <StackPanel x:Name="MessageSection" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="SourceText" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
                    <HyperlinkButton x:Name="ViewInSlackLink" Content="View in Slack" FontSize="11"
                                     Padding="0" Click="OnViewInSlackClicked" Visibility="Collapsed" />
                </StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontStyle="Italic" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="DetailsSection" Spacing="4">
                <TextBlock x:Name="DetailsHeader" Text="DETAILS" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
                <RichTextBlock x:Name="DetailsText" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="RepoSection" Spacing="4">
                <TextBlock Text="REPOSITORY" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
                <TextBlock x:Name="RepoText" />
            </StackPanel>

            <TextBlock x:Name="TimestampText" Foreground="Gray" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
