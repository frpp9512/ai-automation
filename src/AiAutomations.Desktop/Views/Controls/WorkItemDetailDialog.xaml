<ContentDialog
    x:Class="AiAutomations.Desktop.Views.Controls.WorkItemDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Task details"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="12" MinWidth="520" MaxWidth="600">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <HyperlinkButton x:Name="ViewInSlackLink" Content="View originating message in Slack"
                                 Click="OnViewInSlack" Visibility="Collapsed" />
                <Button x:Name="ImplementationPromptButton" Click="OnGenerateImplementationPrompt">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="ImplementationPromptSpinner" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="ImplementationPromptButtonText" Text="Copy implementation prompt" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Content="Export for PM" Click="OnExportForPm" />
            </StackPanel>
            <InfoBar x:Name="ImplementationPromptErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                     Title="Couldn't generate implementation prompt" HorizontalAlignment="Stretch" />

            <TextBox x:Name="TitleBox" Header="Title" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="PriorityBox" Header="Priority" Width="140" />
                <ComboBox x:Name="TypeBox" Header="Type" Width="140" />
                <ComboBox x:Name="RepoBox" Header="Repository" Width="170" />
            </StackPanel>

            <CalendarDatePicker x:Name="DueDatePicker" Header="Due" PlaceholderText="(optional)" />

            <StackPanel Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Description" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1" x:Name="PreviewToggle" Content="Preview" Margin="0,0,8,0" Click="OnTogglePreview" />
                    <Button Grid.Column="2" x:Name="ImproveButton" Click="OnImproveWithAi">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="ImproveSpinner" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="ImproveButtonText" Text="Improve with AI" />
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar x:Name="ImproveErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="Couldn't improve description" />
                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                <Border x:Name="DescriptionPreviewBorder" Visibility="Collapsed" MinHeight="90" Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <RichTextBlock x:Name="DescriptionPreview" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Completion" FontSize="12" Foreground="Gray" />
                    <TextBlock Grid.Column="1" x:Name="PercentLabel" FontSize="12" Foreground="Gray" />
                </Grid>
                <Slider x:Name="PercentSlider" Minimum="0" Maximum="100" StepFrequency="5"
                        ValueChanged="OnPercentChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="COMMENTS" FontWeight="SemiBold" FontSize="11" Foreground="Gray" />
                <StackPanel x:Name="CommentsPanel" Spacing="8" />
                <InfoBar x:Name="RefineCommentErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="Couldn't refine comment" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewCommentBox" PlaceholderText="Add a comment..." Width="320" />
                    <Button x:Name="RefineCommentButton" Click="OnRefineComment">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="RefineCommentSpinner" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="RefineCommentButtonText" Text="Refine with AI" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddCommentButton" Content="Add" Click="OnAddComment" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
