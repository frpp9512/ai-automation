<UserControl
    x:Class="AiAutomations.Desktop.Views.Controls.ActionCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,12">
        <Border x:Name="AccentBar" Background="Gray" CornerRadius="8,0,0,8" HorizontalAlignment="Left" Width="4" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,0,0">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TypeBadge" FontWeight="SemiBold" />
                        <TextBlock x:Name="UrgencyBadge" Foreground="Gray" />
                        <TextBlock x:Name="ConfidenceBadge" Foreground="Gray" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" Content="Details" Padding="0" Click="OnDetails" />
                </Grid>

                <InfoBar x:Name="FailureBar" Severity="Error" IsOpen="False" IsClosable="False" Title="Last attempt failed - edit and re-approve, or reject" />

                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="14" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="SourceText" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="ViewInSlackLink" Content="View in Slack" FontSize="12"
                                     Padding="0" Click="OnViewInSlack" Visibility="Collapsed" />
                </StackPanel>

                <ComboBox x:Name="RepoPicker" Header="Repository" PlaceholderText="Pick a repository before approving..."
                          Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="OnRepoSelectionChanged" />
                <TextBlock x:Name="NoBriefHint" Text="The AI didn't have enough to go on here - write the task yourself below."
                           Foreground="Gray" FontSize="12" Visibility="Collapsed" />
                <TextBox x:Name="PayloadBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                         FontFamily="Consolas" Visibility="Collapsed" />

                <Button x:Name="CopyButton" Content="Copy brief" Visibility="Collapsed" Click="OnCopy" HorizontalAlignment="Left" />

                <InfoBar x:Name="RefineErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="Couldn't refine before approving" />
                <InfoBar x:Name="ReplyErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="Couldn't draft a reply" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="ReplyButton" Content="Reply" Click="OnReplyAndDecline" />
                    <Button x:Name="RejectButton" Content="Reject" Click="OnReject" />
                    <SplitButton x:Name="ApproveButton" Content="Approve" Click="OnApprove">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="RefineAndApproveItem" Text="Refine and approve" Click="OnRefineAndApprove" />
                                <MenuFlyoutItem Text="Check first..." Click="OnCheckFirst" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
