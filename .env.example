# Copy this to .env and fill in real values. .env is gitignored - never commit real secrets.

# Shared secret both containers use to authenticate REST/SignalR calls to each other.
# Any random string works locally - e.g. generate one with: openssl rand -hex 16
API_KEY=

# Slack app credentials - see slack-app-manifest.yaml and ARCHITECTURE.md "Creating the Slack app"
SLACK_BOT_TOKEN=
SLACK_APP_LEVEL_TOKEN=
SLACK_USER_TOKEN=
SLACK_SELF_USER_ID=

# Which IAiDecisionEngine backs classification: "OpenAiCompatible" (default, free-tier friendly)
# or "Anthropic" (needs a real console.anthropic.com key with billing set up).
AI_PROVIDER=OpenAiCompatible

# Only used when AI_PROVIDER=Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only used when AI_PROVIDER=OpenAiCompatible - defaults point at OpenRouter's free router.
# See ARCHITECTURE.md "Choosing a free AI provider" for Groq/xAI/local-Ollama alternatives.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_MODEL=openrouter/free

# true launches a real headless Claude Code session on an approved TaskBrief action instead of
# just finalizing the brief for manual handoff. Needs the `claude` CLI available to the server
# container and a working Anthropic key - leave false otherwise.
CLAUDE_AUTO_LAUNCH=false
